---
import SpokeHeroCtas from "./SpokeHeroCtas.astro";

interface Props {
  id: string;
  title: string;
  intro: string;
  points: readonly { title: string; body: string }[];
}

const { id, title, intro, points } = Astro.props;
---

{/* No `id`: SpokeHero's script handles the #spoke-* hashes, and a matching id would scroll on load. */}
<div
  class="spoke-hero-panel col-start-1 row-start-1 flex flex-col gap-4 hero-stacked:[@media(max-height:700px)]:gap-3 hero-mid:grid xl:grid hero-mid:grid-cols-2 hero-mid:gap-10 xl:grid-cols-[minmax(0,1fr)_560px] xl:gap-16"
  data-hero-panel={id}
  inert
>
  <div class="flex flex-col gap-3 hero-mid:order-2 xl:order-2 hero-mid:justify-center xl:justify-center hero-mid:gap-4 xl:gap-4">
    <h2
      class="font-display text-[40px] leading-[0.94] text-white text-balance outline-none hero-stacked:[@media(max-height:700px)]:text-[34px] sm:text-6xl hero-mid:text-[length:clamp(44px,7svh,72px)] xl:text-[length:clamp(52px,7.5svh,88px)]"
      data-hero-heading
      tabindex="-1"
    >
      {title}
    </h2>
    <p class="mb-0 font-sans text-[15px] leading-[1.4] text-white sm:text-lg hero-mid:text-base xl:text-lg xl:leading-[1.35]">
      {intro}
    </p>
    <ul class="grid list-none grid-cols-1 gap-x-6 p-0 sm:grid-cols-2">
      {
        points.map((point) => (
          <li class="flex items-start gap-3 border-t-2 border-[#0a0908]/20 py-1.5 hero-stacked:[@media(max-height:700px)]:py-1 sm:py-2 [@media(max-height:759px)]:hero-mid:py-1 [@media(max-height:759px)]:xl:py-1">
            <i aria-hidden="true" class="iconoir-check not-italic mt-0.5 shrink-0 text-xl leading-none text-cta-end" />
            <div class="flex flex-col gap-0.5">
              <span class="font-sans text-base font-bold leading-[1.35] text-white xl:text-lg">{point.title}</span>
              <span class="hidden font-sans text-[15px] leading-[1.4] text-white/88 sm:block">{point.body}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="pt-1">
      <SpokeHeroCtas />
    </div>
  </div>
  <div class="relative flex min-h-[130px] flex-1 flex-col justify-center hero-stacked:[@media(max-height:700px)]:min-h-[110px] hero-mid:order-1 xl:order-1 hero-mid:min-h-[280px] xl:min-h-[280px]">
    <slot />
  </div>
</div>
