---
import SpokeHeroCtas from "./SpokeHeroCtas.astro";

interface Props {
  id: string;
  title: string;
  intro: string;
  points: readonly { title: string; body: string }[];
}

const { id, title, intro, points } = Astro.props;
---

{/*
  One chapter panel: visual (default slot) on the left, copy on the right, mirroring the overview.
  Panels are stacked in one grid cell by SpokeHero and switched with `inert`, so the hero is always
  as tall as its tallest panel and nothing below it moves when a chapter opens. No `id`: the
  #spoke-* hashes are handled by SpokeHero's script, and a matching id would make the browser scroll
  down to the (always laid out) panel on load.
*/}
<div
  class="spoke-hero-panel col-start-1 row-start-1 flex flex-col gap-4 max-lg:[@media(max-height:700px)]:gap-3 lg:grid lg:grid-cols-2 lg:gap-10 xl:grid-cols-[minmax(0,1fr)_560px] xl:gap-16"
  data-hero-panel={id}
  inert
>
  <div class="flex flex-col gap-3 lg:order-2 lg:justify-center lg:gap-4">
    <h2
      class="font-display text-[40px] leading-[0.94] text-white text-balance outline-none max-lg:[@media(max-height:700px)]:text-[34px] sm:text-6xl lg:text-[length:clamp(44px,7svh,72px)] xl:text-[length:clamp(52px,7.5svh,88px)]"
      data-hero-heading
      tabindex="-1"
    >
      {title}
    </h2>
    <p class="mb-0 font-sans text-[15px] leading-[1.4] text-white sm:text-lg lg:text-base xl:text-lg xl:leading-[1.35]">
      {intro}
    </p>
    <ul class="grid list-none grid-cols-1 gap-x-6 p-0 sm:grid-cols-2">
      {
        points.map((point) => (
          <li class="flex items-start gap-3 border-t-2 border-[#0a0908]/20 py-1.5 max-lg:[@media(max-height:700px)]:py-1 sm:py-2 [@media(max-height:759px)]:lg:py-1">
            <i aria-hidden="true" class="iconoir-check not-italic mt-0.5 shrink-0 text-xl leading-none text-cta-end" />
            <div class="flex flex-col gap-0.5">
              <span class="font-sans text-base font-bold leading-[1.35] text-white xl:text-lg">{point.title}</span>
              <span class="hidden font-sans text-[15px] leading-[1.4] text-white/88 sm:block">{point.body}</span>
            </div>
          </li>
        ))
      }
    </ul>
    <div class="pt-1">
      <SpokeHeroCtas />
    </div>
  </div>
  <div class="relative flex min-h-[130px] flex-1 flex-col justify-center max-lg:[@media(max-height:700px)]:min-h-[110px] lg:order-1 lg:min-h-[280px]">
    <slot />
  </div>
</div>
