---
import PauseAnimationsToggle from "./PauseAnimationsToggle.astro";

interface Props {
  /** Ambient video background (same clip as the hero) confined to the footer, homepage only. */
  videoBg?: boolean;
}

const { videoBg = false } = Astro.props;

const toolsLinks = [{ href: "/spoke", label: "Spoke" }];
const connectLinks = [{ href: "/contact", label: "Say Hello" }];
const workLinks = [{ href: "/our-work", label: "Case Studies" }, { href: "/about", label: "About Our Co-Op" }];
const supportLinks = [{ href: "https://spoke.withtheranks.com/", label: "Spoke Support" }, { href: "/contact", label: "Contact Us" }];

const socialIcons = [
  { class: "iconoir-instagram", label: "Instagram" },
  { class: "iconoir-tiktok", label: "TikTok" },
  { class: "iconoir-twitter", label: "Twitter" },
  { class: "iconoir-x", label: "X" },
  { class: "iconoir-discord", label: "Discord" },
] as const;
---

<footer class:list={["relative border-black/20 bg-brand-blue text-brand-cream", videoBg && "isolate pb-4 sm:pb-6"]}>
  {
    videoBg && (
      <div
        class="pointer-events-none absolute inset-0 -z-10 overflow-hidden opacity-20"
        style="mask-image: linear-gradient(to bottom, transparent 0%, transparent 10%, black 60%), radial-gradient(circle at 50% 25%, transparent 0%, transparent 30%, black 75%); mask-composite: intersect; -webkit-mask-image: linear-gradient(to bottom, transparent 0%, transparent 10%, black 60%), radial-gradient(circle at 50% 25%, transparent 0%, transparent 30%, black 75%); -webkit-mask-composite: source-in;"
      >
        <video
          class="h-full w-full object-cover mix-blend-screen motion-reduce:hidden"
          data-bg-video
          loop
          muted
          playsinline
          poster="/assets/home/hero-bg-poster.jpg"
          preload="none"
        >
          <source src="/assets/home/hero-bg.mp4" type="video/mp4" />
        </video>
      </div>
    )
  }
  <div class="relative mx-auto max-w-screen-xl px-20 pt-16 pb-20 sm:pt-20 sm:pb-24 lg:pt-28 lg:pb-32">
    <div class="mt-20 sm:mt-24 lg:mt-0">
      <img alt="With the Ranks Worker Cooperative" class="mx-auto h-auto w-full max-w-full" src="/assets/home/footer-wordmark.svg" />
    </div>

    <!-- <div class="mt-10 flex items-center justify-center gap-5 text-brand-cream sm:mt-12 sm:gap-6">
      {socialIcons.map((item) => (
        <span class="inline-flex size-7 items-center justify-center sm:size-8" role="img" aria-label={item.label}>
          <i class:list={[item.class, "not-italic text-[26px] leading-none sm:text-[28px]"]} aria-hidden="true" />
        </span>
      ))}
    </div> -->

    <p class="mx-auto mt-20 sm:mt-24 lg:mt-32 max-w-screen-sm text-center text-brand-cream text-[16px]">
      This site and its content are <a href="https://github.com/With-the-Ranks/withtheranks-astro" target="_blank" class="font-bold underline underline-offset-4 text-white">open-source</a> under the <a href="https://github.com/With-the-Ranks/withtheranks-astro/blob/main/LICENSE" target="_blank" class="font-bold underline underline-offset-4 text-white">GNU General Public License</a>, except where proprietary branding, third-party assets, client references, or partner content carry their own licenses.
      <br />
      <br />
      <a href="https://www.theleagueofmoveabletype.com/league-gothic" target="_blank" class="font-bold underline underline-offset-4 text-white">League Gothic</a> was designed by <a href="https://www.theleagueofmoveabletype.com/team/caroline-hadilaksono" target="_blank" class="font-bold underline underline-offset-4 text-white">Caroline Hadilaksono</a>, <a href="https://www.theleagueofmoveabletype.com/team/micah-rich" target="_blank" class="font-bold underline underline-offset-4 text-white">Micah Rich</a>, <a href="https://www.theleagueofmoveabletype.com/team/tyler-finck" target="_blank" class="font-bold underline underline-offset-4 text-white">Tyler Finck</a>, and <a href="https://www.theleagueofmoveabletype.com/team/dannci" target="_blank" class="font-bold underline underline-offset-4 text-white">Dannci</a> and is licensed under the <a href="https://github.com/theleagueof/league-gothic/blob/master/OFL.md" target="_blank" class="font-bold underline underline-offset-4 text-white">SIL Open Font License</a>.
      <br />
      <br />
      Tofino was designed by <a href="https://alannamunro.com/" target="_blank" class="font-bold underline underline-offset-4 text-white">Alanna Munro</a> and is licensed under the <a href="https://www.losttype.com/images/samples/License_Commercial_Sample.pdf" target="_blank" class="font-bold underline underline-offset-4 text-white">Commercial Umbrella License from Lost Type Co-op</a>.
      <br />
      <br />
      The With the Ranks name, wordmark, logos, trademarks, service marks, visual identity, and branding materials are excluded from the GPL and remain the exclusive intellectual property of With the Ranks. The GPL grants no rights to use, reproduce, modify, distribute, or create derivative works of these branding assets, except with the express written permission of With the Ranks.
    </p>
  </div>
  {videoBg && <PauseAnimationsToggle />}
</footer>
